# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logging
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=docgen
POSTGRES_PASSWORD=docgen
POSTGRES_DB=docgen
POSTGRES_PORT=5432
DB_URL=postgres://docgen:docgen@localhost:5432/docgen?sslmode=disable
DB_MAX_CONNS=10

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=docgen
MINIO_ROOT_PASSWORD=docgen-secret

# S3 storage (MinIO)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=docgen
S3_SECRET_KEY=docgen-secret
S3_USE_SSL=false
S3_REGION=us-east-1
# Копии DOCX-шаблонов, по которым выпущены документы
S3_TEMPLATES_BUCKET=docgen-templates
S3_DOCUMENTS_BUCKET=docgen-documents

# Gotenberg
GOTENBERG_PORT=3100
GOTENBERG_URL=http://localhost:3100
GOTENBERG_TIMEOUT=10s
# Сколько конвертаций одновременно: LibreOffice тяжёлый, без предела всплеск запросов съест память
GOTENBERG_MAX_CONCURRENCY=4

# Documents
DOCUMENTS_CLEANUP_INTERVAL=1h
DOCUMENTS_CLEANUP_BATCH=100

# Admin
ADMIN_SESSION_TTL=12h
# Собранная админка (make admin-build); пусто — сервис её не раздаёт
ADMIN_UI_DIR=../admin/dist
# Демо-стенд: открыть админку без входа. ТОЛЬКО стенд с тестовыми данными — журнал
# и входные данные документов увидит любой, кто открыл адрес.
ADMIN_AUTH_DISABLED=false
